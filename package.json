{
  "name": "trystero-monorepo",
  "version": "0.27.0-beta1",
  "private": true,
  "keywords": [
    "bittorrent",
    "chat",
    "decentralized",
    "firebase",
    "matchmaking",
    "mqtt",
    "nostr",
    "p2p",
    "pairing",
    "peer to peer",
    "react",
    "realtime",
    "serverless",
    "signaling",
    "supabase",
    "torrent",
    "webrtc",
    "webtorrent"
  ],
  "author": {
    "name": "Dan Motzenbecker",
    "email": "dan@oxism.com",
    "url": "https://oxism.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmotz/trystero.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:test": "TEST_BUILD=1 tsdown",
    "copy-readmes-for-publish": "node scripts/copy-readmes.ts",
    "test": "pnpm run build:test && playwright test ./test",
    "test:node": "pnpm run build && node --import ./scripts/register-hooks.ts --import ./test/node/diagnostic-summary.ts --test 'test/node/*.spec.ts'",
    "test:bun": "pnpm run build && bun test test/node/*.spec.ts",
    "test:deno": "pnpm run build && deno test test/node/*.spec.ts -A --no-check",
    "test:ice": "pnpm run build && node --import ./scripts/register-hooks.ts scripts/test-ice.ts",
    "test:turn:local": "pnpm run build:test && node scripts/test-local-turn.mjs",
    "test:proxy": "PROXY=$(node --import ./scripts/register-hooks.ts scripts/find-proxy.ts) pnpm test",
    "test:relays": "pnpm run build && node --import ./scripts/register-hooks.ts scripts/test-relays.ts",
    "update:nostr-relays": "pnpm run build:test && node scripts/update-nostr-relays.ts",
    "measure:nostr-announcements": "pnpm run build && node scripts/measure-nostr-announcements.ts",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check . --fix",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "find-proxy": "node --import ./scripts/register-hooks.ts scripts/find-proxy.ts",
    "get-bundle-sizes": "node scripts/get-bundle-sizes.ts",
    "typecheck": "pnpm --filter './packages/*' exec tsc --noEmit && tsc -p tsconfig.json --noEmit",
    "publish": "pnpm login && pnpm build && pnpm copy-readmes-for-publish && pnpm -r publish --no-git-checks --access public --tag \"$(node -p 'JSON.parse(require(\"fs\").readFileSync(\"packages/trystero/package.json\", \"utf8\")).version.includes(\"-\") ? \"beta\" : \"latest\"')\""
  },
  "dependencies": {
    "@trystero-p2p/core": "workspace:*",
    "@trystero-p2p/firebase": "workspace:*",
    "@trystero-p2p/mqtt": "workspace:*",
    "@trystero-p2p/nostr": "workspace:*",
    "@trystero-p2p/supabase": "workspace:*",
    "@trystero-p2p/torrent": "workspace:*",
    "@trystero-p2p/ws-relay": "workspace:*",
    "trystero": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "chalk": "^6.0.1",
    "mqtt": "^5.16.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "serve": "^14.2.6",
    "source-map": "^0.8.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "werift": "^0.24.4",
    "ws": "^8.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0"
}
